# --- Application ---
APP_NAME="Court Cause List Agent"
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=sqlite:///./cause_list.db

# --- Court website ---
COURT_BASE_URL=https://aphc.gov.in
COURT_DEPARTMENTS=Social Welfare
# --- CAPTCHA ---
CAPTCHA_SOLVER=ocr
CAPTCHA_MAX_RETRIES=3

# --- Scheduler ---
SCHEDULER_START_TIME=17:00
SCHEDULER_END_TIME=22:00
SCHEDULER_POLL_INTERVAL_MINUTES=15

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=notifications@causelistagent.com
SMTP_USE_TLS=true

# --- File storage ---
PDF_STORAGE_DIR=./storage/pdfs